<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- The three coordinates that identify this project to Maven. -->
  <groupId>com.anpr.platform</groupId>
  <artifactId>anpr-alert-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <name>ANPR Alert Platform</name>

  <properties>
    <!-- Compile against the Java 17 API, not just Java 17 syntax. -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      2.2.1 rather than the newer 2.3.0 on purpose: the Kafka connector is released
      separately, and its newest build (5.0.0-2.2) targets Flink 2.2. Matching them
      avoids betting on cross-version compatibility later.
    -->
    <flink.version>2.2.1</flink.version>
    <junit.version>5.10.2</junit.version>

    <!--
      The Kafka connector ships on its own release train: 5.0.0-2.2 means connector 5.0.0
      built for Flink 2.2. This is the pairing the flink.version above exists to satisfy.
    -->
    <flink.kafka.version>5.0.0-2.2</flink.kafka.version>
    <!--
      Already on the classpath transitively via flink-connector-kafka. Declared
      explicitly because the publisher imports KafkaProducer directly, and code
      should not compile against a dependency it did not ask for. Same version
      the connector resolves to, so nothing on the classpath changes.
    -->
    <kafka.clients.version>4.2.0</kafka.clients.version>

    <!--
      Matches the version Flink shades internally. Flink ships only flink-shaded-jackson,
      relocated under org.apache.flink.shaded.jackson2 and not meant for application code,
      so a real Jackson has to be declared rather than borrowed.
    -->
    <jackson.version>2.18.2</jackson.version>
  </properties>

  <dependencies>
    <!-- KafkaSource and KafkaSink: the buffer between NiFi and this job. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-kafka</artifactId>
      <version>${flink.kafka.version}</version>
    </dependency>

    <!-- Reads and writes the JSON that travels on the topics. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!--
      The DataStream API: event time, watermarks, keyBy, windows.
      compile scope, not provided: this job has to run with plain `java -jar` and from
      the IDE, not only after being submitted to a Flink cluster.
    -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-streaming-java</artifactId>
      <version>${flink.version}</version>
    </dependency>

    <!--
      The shared source machinery KafkaSource is built on. The Kafka connector marks it
      provided, since a Flink cluster ships it - but this job runs as a plain JVM, so it
      has to be declared, for the same reason flink-clients is.
    -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-base</artifactId>
      <version>${flink.version}</version>
    </dependency>

    <!-- Lets main() start a local MiniCluster, which is what makes the job debuggable. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-clients</artifactId>
      <version>${flink.version}</version>
    </dependency>

    <!--
      An SLF4J binding. Flink logs through the SLF4J API but deliberately ships no
      implementation, so without one it prints a "Failed to load class StaticLoggerBinder"
      warning and swallows every log line. Version 1.7.36 to match the slf4j-api that
      Flink pulls in - a 2.x binding would not attach to a 1.7 API.

      runtime scope: no source file imports it, only the running JVM needs it.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>1.7.36</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- The standalone producer used by the publisher that stands in for NiFi. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>${kafka.clients.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Runs the tests during `mvn test`. Pinned so the version cannot drift. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
    </plugins>
  </build>

</project>
